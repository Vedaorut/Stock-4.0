{
  "name": "telegram-shop-backend",
  "version": "1.0.0",
  "description": "Backend API for Telegram E-Commerce Platform",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "worker": "node src/workers/syncWorker.js",
    "worker:dev": "nodemon src/workers/syncWorker.js",
    "test": "NODE_OPTIONS=--experimental-vm-modules npx jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules npx jest --watch",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules npx jest --coverage",
    "lint": "eslint src/ __tests__/ --fix",
    "lint:check": "eslint src/ __tests__/",
    "test:all": "npm run lint:check && npm test",
    "test:ci": "NODE_ENV=test node database/migrations.cjs --apply && npm test",
    "smoke": "NODE_OPTIONS=--experimental-vm-modules npx jest __tests__/smoke --testTimeout=30000",
    "smoke:ci": "NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules npx jest __tests__/smoke --testTimeout=30000 --forceExit --detectOpenHandles",
    "preflight": "npm run lint:check && npm test && npm run smoke && echo '✅ Preflight passed - ready for release'",
    "db:seed": "psql postgresql://sile@localhost:5432/telegram_shop -f database/seed.sql",
    "predeploy": "bash scripts/predeploy.sh",
    "deploy": "bash scripts/deploy.sh",
    "verify": "bash scripts/postdeploy-verify.sh",
    "rollback": "bash scripts/rollback.sh",
    "rollback:flags": "bash scripts/rollback.sh flags"
  },
  "keywords": [
    "telegram",
    "ecommerce",
    "crypto",
    "api"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "@sentry/node": "^10.28.0",
    "axios": "^1.6.0",
    "bull": "^4.16.5",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "decimal.js": "^10.6.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.8.2",
    "jsonwebtoken": "^9.0.2",
    "openai": "^4.37.2",
    "pg": "^8.11.0",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "^4.3.1",
    "tronweb": "^5.3.0",
    "wallet-validator": "^0.3.18",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^4.7.1",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@jest/globals": "^29.7.0",
    "globals": "^16.4.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "supertest": "^7.1.4"
  }
}
