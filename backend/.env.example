# Server Configuration
PORT=3000
NODE_ENV=development
HTTPS_ENABLED=false

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/telegram_shop

# Redis (for Bull queue and bot sessions)
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# Telegram Bot
# CRITICAL: This token is used for Telegram WebApp initData validation (HMAC-SHA256)
# Never expose this token in frontend code or client-side scripts
TELEGRAM_BOT_TOKEN=your-bot-token-here
TELEGRAM_WEBHOOK_URL=https://your-domain.com/webhook

# BlockCypher API (BTC, LTC webhooks)
BLOCKCYPHER_API_KEY=your-blockcypher-token-here
BLOCKCYPHER_WEBHOOK_URL=https://your-domain.com/webhooks/blockcypher?token=your-random-secret-here
BLOCKCYPHER_WEBHOOK_SECRET=your-random-secret-here

# Etherscan API (ETH, USDT ERC-20 polling)
ETHERSCAN_API_KEY=your-etherscan-api-key-here

# TronGrid API (USDT TRC-20 polling)
TRONGRID_API_KEY=your-trongrid-api-key-here

# Confirmation thresholds (for blockchain payment verification)
# Orders use seller wallets (set in shop settings), not platform wallets
CONFIRMATIONS_BTC=3
CONFIRMATIONS_LTC=3
CONFIRMATIONS_ETH=3
CONFIRMATIONS_TRON=1

# Pending order limits / expiry
INVOICE_EXPIRY_SECONDS=1800
MAX_PENDING_ORDERS_PER_USER=1
CANCELLATION_COOLDOWN_THRESHOLD=3
CANCELLATION_COOLDOWN_MINUTES=15
CANCELLATION_WINDOW_SECONDS=3600

# Shop Registration
SHOP_REGISTRATION_COST=25

# Security & CORS
FRONTEND_URL=https://your-webapp-url.com
# NGROK_URL will be set automatically by start.sh (optional)
# NGROK_URL=https://your-ngrok-url.ngrok-free.app

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Internal API secret (for bot → backend communication)
INTERNAL_SECRET=change-me-in-production-use-strong-random-string
