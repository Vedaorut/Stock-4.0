# ============================================
# Status Stock Backend - Production Environment
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env file to git!

# Server Configuration
PORT=3000
NODE_ENV=production
HTTPS_ENABLED=true

# Database (use connection pooling in production)
# Neon: postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
# Supabase: postgresql://postgres:password@db.xxx.supabase.co:5432/postgres
DATABASE_URL=postgresql://user:password@host:5432/telegram_shop?sslmode=require

# Redis (for Bull queue and bot sessions)
# Redis Cloud, Upstash, or self-hosted
REDIS_HOST=your-redis-host.com
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password

# JWT (CRITICAL: Generate a strong secret!)
# Run: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_64_BYTE_RANDOM_HEX_STRING
JWT_EXPIRES_IN=7d

# Telegram Bot
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_WEBHOOK_URL=https://your-domain.com/webhook

# CrystalPay (crypto payments)
CRYSTALPAY_LOGIN=your_crystalpay_login
CRYSTALPAY_SECRET=your_crystalpay_secret_key

# BlockCypher API (BTC, LTC verification)
BLOCKCYPHER_API_KEY=your-blockcypher-api-key
BLOCKCYPHER_WEBHOOK_URL=https://your-domain.com/webhooks/blockcypher
BLOCKCYPHER_WEBHOOK_SECRET=generate-random-32-char-string

# Etherscan API (ETH verification)
ETHERSCAN_API_KEY=your-etherscan-api-key

# TronGrid API (USDT TRC-20)
TRONGRID_API_KEY=your-trongrid-api-key

# Confirmation thresholds
CONFIRMATIONS_BTC=3
CONFIRMATIONS_LTC=3
CONFIRMATIONS_ETH=12
CONFIRMATIONS_TRON=19

# Shop Registration
SHOP_REGISTRATION_COST=25

# Security & CORS
# Your webapp domain (without trailing slash)
FRONTEND_URL=https://your-webapp.vercel.app

# Rate Limiting (stricter in production)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30

# Internal API secret (bot -> backend)
# Run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_SECRET=CHANGE_ME_TO_32_BYTE_RANDOM_HEX_STRING

# ============================================
# MONITORING (Highly Recommended)
# ============================================

# Sentry Error Tracking
# Get DSN from: https://sentry.io/settings/projects/YOUR_PROJECT/keys/
SENTRY_DSN=https://xxx@oyyy.ingest.sentry.io/zzz

# Admin Telegram ID (for alerts)
ADMIN_TELEGRAM_ID=123456789

# ============================================
# OPTIONAL
# ============================================

# DeepSeek AI (for AI product descriptions)
DEEPSEEK_API_KEY=your-deepseek-api-key

# Enable debug routes (set to 'true' only for troubleshooting)
ENABLE_DEBUG_ROUTES=false

# Log level (error, warn, info, debug)
LOG_LEVEL=info
